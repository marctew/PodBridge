# Copy to .env and fill in. .env is git-ignored. Never commit real values.
# Docker passes every line of this file into the container, so once the
# Phase 0 probes are done, blank out the probe section below.

# --- App ---
# Login password for the web UI
APP_PASSWORD=
# Flask session key, 32+ chars:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key for secrets stored in the database. Back it up: losing it means re-entering credentials.
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
TZ=Europe/London
# Set to true if you only reach PodBridge over HTTPS (via the reverse proxy)
SESSION_COOKIE_SECURE=false

# --- Phase 0 probes only (scripts/probe_*.py) ---
# Patreon: value of the session_id cookie on www.patreon.com
PATREON_SESSION_ID=
# Optional overrides (defaults are the Button Boys IDs from the spec)
# PATREON_CAMPAIGN_ID=14434926
# PATREON_COLLECTION_ID=1909234
# PATREON_SAMPLE_POST_ID=171048709
# PATREON_SAMPLE_MEDIA_ID=755348961

# Pocket Casts account
POCKETCASTS_EMAIL=
POCKETCASTS_PASSWORD=
# Optional: substring of the private Button Boys feed title, to pick it from your subscriptions
POCKETCASTS_PODCAST_MATCH=Button Boys
